#!/bin/bash
# riscvbench: Simple CLI wrapper for Phase-1 SIT engine

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PHASE1_DIR="$SCRIPT_DIR/Phase-1"

# Ensure Python 3
if ! command -v python3 &> /dev/null; then
    echo "Error: python3 not found in PATH" >&2
    exit 1
fi

# Forward all arguments to riscvbench.py
cd "$PHASE1_DIR"
python3 riscvbench.py "$@"
