set_global_assignment -name IP_FILE qsys_files/ip/niosv_bringup/niosv_bringup_intel_niosv_m_0.ip
set_global_assignment -name IP_FILE qsys_files/ip/niosv_bringup/niosv_bringup_jtag_uart_0.ip
