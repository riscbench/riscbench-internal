# --------------------------------------------------------------------------
# Quartus Prime Project Settings
# --------------------------------------------------------------------------

set_global_assignment -name TOP_LEVEL_ENTITY sit_engine_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 26.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.0 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name DEVICE A5ED013BB32AE4SR1
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name BOARD default

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL

set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ

# --------------------------------------------------------------------------
# Platform Designer / IP files
# --------------------------------------------------------------------------

set_global_assignment -name SDC_FILE sit_core.sdc
set_global_assignment -name SYSTEMVERILOG_FILE sit_engine_top.sv

set_global_assignment -name QIP_FILE qsys_files/niosv_bringup/niosv_bringup.qip
set_global_assignment -name QIP_FILE qsys_files/ip/niosv_bringup/niosv_bringup_intel_onchip_memory_0/niosv_bringup_intel_onchip_memory_0.qip

set_global_assignment -name IP_FILE qsys_files/ip/niosv_bringup/niosv_bringup_clock_in.ip
set_global_assignment -name IP_FILE qsys_files/ip/niosv_bringup/niosv_bringup_reset_in.ip
